{
  "name": "@pardalis/escenario-engine",
  "version": "3.0.0-alfa.0",
  "description": "Motor del modo Aventura de Pardalis: personajes de papel en un escenario 3D",
  "license": "MPL-2.0",
  "author": "Pardalis",
  "keywords": [
    "pardalis",
    "juego",
    "educativo",
    "three"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./validar": {
      "types": "./dist/validar.d.ts",
      "default": "./dist/validar.js"
    }
  },
  "bin": {
    "escenario-engine": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit && echo 'No type errors'",
    "construir": "rm -rf dist && tsc --project tsconfig.construir.json",
    "prepare": "bun run construir"
  },
  "dependencies": {
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
