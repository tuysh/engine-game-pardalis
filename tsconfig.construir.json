{
  // Genera `dist/`: JavaScript (ESM) y tipos `.d.ts`, un archivo por cada archivo de `src/`.
  // Se usa con `bun run construir`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src"],
  // No se publican las pruebas ni los adaptadores falsos que solo usan las pruebas.
  "exclude": ["src/**/*.test.ts", "src/adaptadores/memoria"]
}
